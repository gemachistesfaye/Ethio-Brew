# --- SERVER CONFIG ---
PORT=5000
NODE_ENV=production

# --- CORS / CLIENT ---
FRONTEND_URL=https://ethio-brew.vercel.app

# --- DATABASE CONFIG (Supabase) ---
# From Supabase Dashboard > Settings > Database > Connection string > URI
# Format: postgresql://postgres.[PROJECT-REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres
DB_HOST=aws-0-eu-west-1.pooler.supabase.com
DB_PORT=6543
DB_USER=postgres.[YOUR-PROJECT-REF]
DB_PASSWORD=your_supabase_db_password
DB_NAME=postgres

# --- SECURITY: JWT SECRETS (>=32 chars, MUST be different) ---
# Generate: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace_with_strong_random_access_secret_at_least_32_chars
JWT_REFRESH_SECRET=replace_with_a_different_strong_random_secret_32chars

# --- INITIAL ADMIN SEED (optional) ---
ADMIN_EMAIL=admin@ethiobrew.com
ADMIN_PASSWORD=replace_with_a_strong_password

# --- EMAIL (SMTP via Gmail) ---
EMAIL_USER=your_email@gmail.com
EMAIL_PASS=your_gmail_app_password

# --- AI (Optional) ---
GEMINI_API_KEY=your_gemini_api_key

# --- NOTIFICATIONS (Optional) ---
TELEGRAM_BOT_TOKEN=your_bot_token
TELEGRAM_CHAT_ID=your_chat_id
