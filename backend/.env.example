# --- SERVER CONFIG ---
PORT=5000
NODE_ENV=production

# --- CORS / CLIENT ---
# The exact origin of your frontend (no trailing slash).
FRONTEND_URL=https://ethio-brew.vercel.app

# --- DATABASE CONFIG (AIVEN / CLOUD) ---
DB_HOST=mysql-your-instance.aivencloud.com
DB_PORT=12345
DB_USER=avnadmin
DB_PASSWORD=replace_with_a_strong_db_password
DB_NAME=defaultdb

# --- SECURITY: JWT SECRETS ---
# Generate strong random values (>= 32 chars) and make the two DIFFERENT:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace_with_strong_random_access_secret
JWT_REFRESH_SECRET=replace_with_a_different_strong_random_secret

# --- INITIAL ADMIN SEED (optional) ---
# Used only the first time an admin account needs to be created. The server
# will NOT create an admin unless ADMIN_PASSWORD is set and at least 8 chars.
ADMIN_EMAIL=admin@ethiobrew.com
ADMIN_PASSWORD=replace_with_a_strong_password

# --- EMAIL (SMTP via Gmail) ---
EMAIL_USER=your_email@gmail.com
EMAIL_PASS=your_gmail_app_password

# --- AI ---
GEMINI_API_KEY=your_gemini_api_key

# --- NOTIFICATIONS (optional) ---
TELEGRAM_BOT_TOKEN=your_bot_token
TELEGRAM_CHAT_ID=your_chat_id
